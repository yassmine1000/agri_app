{
  "compilerOptions": {
      "target": "es2017",
      "module": "commonjs",
      "lib": ["es6", "dom"],
      "types": ["node"],
      "allowJs": true,
      "outDir": "dist",
      "rootDir": "src",
      "strict": false,
      "noImplicitAny": false,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}